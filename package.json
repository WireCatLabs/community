{
  "name": "@wirecat/community",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.28.8",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "docs:lint": "markdownlint-cli2",
    "docs:spell": "cspell lint --config cspell.json --no-progress",
    "prepare": "lefthook install || true",
    "standards:check": "node config/wirecat/check.mjs",
    "ci:quick": "node --test --test-timeout=10000 scripts/tests/*.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@cspell/dict-en-gb": "5.0.38",
    "@cspell/dict-es-es": "3.0.9",
    "@cspell/dict-ru_ru": "2.3.4",
    "cspell": "10.4.0",
    "lefthook": "2.2.2",
    "markdownlint-cli2": "0.24.0"
  }
}
